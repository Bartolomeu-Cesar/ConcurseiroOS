{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noEmitOnError": false,
    "outFile": "./app.js",
    "sourceMap": false,
    "removeComments": false,
    "declaration": false
  },
  "include": ["src/**/*.ts"]
}
