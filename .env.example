# ConcurseiroOS - Configuração de Ambiente
# Copie este arquivo para .env e preencha os valores

# ========== GERAL ==========
ENV=dev                          # dev | production
DB_PATH=./progress.db
PDF_ROOT=./pdfs
BACKUP_DIR=./backups

# PostgreSQL (optional, for multi-user production)
# DATABASE_URL=postgresql://concurseiro:password@localhost:5432/concurseiroos
# PG_POOL_MIN=2
# PG_POOL_MAX=20

# ========== AUTH ==========
AUTH_ENABLED=false               # true para exigir login
JWT_SECRET=                      # auto-gerado se vazio
JWT_EXPIRE_HOURS=72

# ========== EMAIL (SMTP) ==========
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ========== AI TUTOR (Multi-Provider) ==========
# O sistema detecta automaticamente o primeiro provider configurado
# Ou defina AI_PROVIDER para forçar um específico

AI_PROVIDER=auto                 # auto | openai | claude | gemini | grok | deepseek | mistral | groq | together | cohere | perplexity | kimi | glm | bedrock | ollama
AI_MODEL=                        # deixe vazio para usar default do provider
AI_DAILY_TOKEN_LIMIT=50000      # tokens/dia por usuário (0 = ilimitado)

# --- OpenAI (gpt-4o-mini, gpt-4o, o1-mini) ---
OPENAI_API_KEY=                  # sk-...

# --- Anthropic Claude (claude-3-5-sonnet, claude-3-5-haiku) ---
ANTHROPIC_API_KEY=               # sk-ant-...

# --- Google Gemini (gemini-2.0-flash, gemini-1.5-pro) ---
GEMINI_API_KEY=                  # AIza...

# --- xAI Grok (grok-2, grok-2-mini) ---
XAI_API_KEY=                     # xai-...

# --- DeepSeek (deepseek-chat, deepseek-reasoner) ---
DEEPSEEK_API_KEY=                # sk-...

# --- Mistral AI (mistral-small-latest, mistral-large-latest) ---
MISTRAL_API_KEY=                 # ...

# --- Groq (llama-3.1-70b-versatile, mixtral-8x7b-32768) — inferência ultrarrápida ---
GROQ_API_KEY=                    # gsk_...

# --- Together AI (meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo) ---
TOGETHER_API_KEY=                # ...

# --- Cohere (command-r-plus, command-r) ---
COHERE_API_KEY=                  # ...

# --- Perplexity (llama-3.1-sonar-large-128k-online) — com busca web ---
PERPLEXITY_API_KEY=              # pplx-...

# --- Kimi / Moonshot AI (moonshot-v1-8k, moonshot-v1-32k) ---
KIMI_API_KEY=                    # sk-...

# --- GLM / ZhipuAI / ChatGLM (glm-4-flash, glm-4) ---
GLM_API_KEY=                     # ...

# --- Amazon Bedrock (Claude, Titan, Llama via AWS) ---
AWS_BEDROCK_REGION=              # us-east-1 (requer IAM credentials configuradas)
AWS_BEDROCK_MODEL=anthropic.claude-3-haiku-20240307-v1:0

# --- Ollama (modelos locais - llama3.1, mistral, phi3, etc.) ---
OLLAMA_URL=http://localhost:11434  # Funciona sem API key se Ollama estiver rodando

# ========== PUSH NOTIFICATIONS ==========
# VAPID keys são auto-geradas se não fornecidas
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@concurseiroos.app
